<?xml version="1.0" encoding="utf-8"?>
<!-- Root container for the Settings screen. Vertical LinearLayout so stuff stacks top to bottom -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- This inner layout holds the actual settings content. weight=1 makes it fill all the space
         above the bottom nav, so the nav stays pinned to the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Big bold "Settings" header at the top of the screen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- The toggle switch for the expiring-soon alerts. We read its on/off state in code -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Expiring-soon alerts"
            android:textSize="16sp" />

        <!-- Little helper text under the switch explaining what it does -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="When on, pantry items that expire within 3 days are highlighted." />
    </LinearLayout>

    <!-- The bottom navigation bar, same menu as the other screens so tabs stay consistent -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:paddingBottomSystemWindowInsets="false" />
</LinearLayout>